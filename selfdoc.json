{
  "version": "0.2.0",
  "description": "A deterministic linter for architecture, with tiered auto-fixes: strictcode builds a graph of a codebase's modules, callables, and types, and enforces dependency hygiene, dead-code, cycle, and library-boundary rules across Python, Go, and TypeScript/JavaScript",
  "repo": "https://github.com/smm-h/strictcode",
  "base_url": "https://smmh.dev/strictcode",
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  },
  "source": [
    {"path": "internal/", "language": "go"},
    {"path": "cmd/", "language": "go"}
  ],
  "docs": ".stricttools/docs/",
  "output": ".stricttools/docs-cache/build/",
