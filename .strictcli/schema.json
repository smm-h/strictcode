{
  "commands": {
    "analyze": {
      "args": [
        {
          "default": ".",
          "help": "Project or workspace root to analyze",
          "name": "dir",
          "required": false
        }
      ],
      "effect": "read_only",
      "flags": [
        {
          "default": "strictcode.toml",
          "help": "Config file name, resolved relative to the analyzed directory",
          "name": "config",
          "type": "str"
        }
      ],
      "help": "Analyze a project or workspace directory and report findings",
      "name": "analyze",
      "payload_schema": {
        "additionalProperties": false,
        "properties": {
          "findings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "fix": {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "tier": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "tier",
                    "description"
                  ],
                  "type": "object"
                },
                "message": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                },
                "severity": {
                  "enum": [
                    "error",
                    "warning"
                  ]
                },
                "target": {
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "workspace_member",
                        "module",
                        "entry_point",
                        "function",
                        "closure",
                        "type",
                        "type_param",
                        "variable",
                        "endpoint",
                        "db_entity"
                      ]
                    },
                    "line": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "file",
                    "line"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "rule",
                "severity",
                "message",
                "target"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "format_version": {
            "const": 1
          },
          "strictcode_version": {
            "type": "string"
          },
          "workspace_root": {
            "type": "string"
          }
        },
        "required": [
          "format_version",
          "strictcode_version",
          "workspace_root",
          "findings"
        ],
        "type": "object"
      }
    },
    "fix": {
      "args": [
        {
          "default": ".",
          "help": "Project or workspace root",
          "name": "dir",
          "required": false
        }
      ],
      "constraints": [
        {
          "flags": [
            "apply",
            "preview"
          ],
          "type": "mutex"
        }
      ],
      "dry_run_supported": false,
      "dry_run_unsupported_reason": "the file rewrites happen inside the fix package's apply-and-verify path, outside the effects handle; pass --preview to list the planned fixes without touching a file",
      "effect": "mutating",
      "flags": [
        {
          "default": "strictcode.toml",
          "help": "Config file name, resolved relative to the analyzed directory",
          "name": "config",
          "type": "str"
        },
        {
          "help": "Apply the planned fixes (files are rewritten, then verified; mismatches roll back)",
          "name": "apply",
          "negatable": true,
          "type": "bool"
        },
        {
          "help": "List the planned fixes without touching any file",
          "name": "preview",
          "negatable": true,
          "type": "bool"
        }
      ],
      "help": "Apply tier-1 (guaranteed behavior-preserving) fixes with post-fix graph re-verification",
      "name": "fix"
    }
  },
  "defaults": {
    "app": {
      "commands": {},
      "config": false,
      "deprecated": {},
      "env_prefix": null,
      "global_flags": [],
      "groups": {},
      "tag_contracts": {}
    },
    "arg": {
      "choices": null,
      "default": null,
      "required": true,
      "type": "str",
      "variadic": false
    },
    "command": {
      "args": [],
      "constraints": [],
      "flags": [],
      "hidden": false,
      "interactive": false,
      "passthrough": false,
      "tags": []
    },
    "flag": {
      "choices": null,
      "default": null,
      "env": null,
      "env_separator": null,
      "hidden": false,
      "negatable": null,
      "repeatable": false,
      "short": null,
      "unique": false
    },
    "group": {
      "commands": {},
      "deprecated": {},
      "groups": {},
      "hidden": false,
      "tags": []
    },
    "schema_version": 1
  },
  "groups": {
    "matrix": {
      "commands": {
        "gen": {
          "dry_run_supported": false,
          "dry_run_unsupported_reason": "the matrix is written with a direct file write, outside the effects handle, so a preview would report nothing while the real run rewrites the file",
          "effect": "mutating",
          "flags": [
            {
              "default": "docs/MATRIX.md",
              "help": "Output path for the matrix",
              "name": "out",
              "type": "str"
            }
          ],
          "help": "Write the generated support matrix (rules and capabilities per language)",
          "name": "gen"
        }
      },
      "help": "Language x feature support matrix",
      "name": "matrix"
    },
    "registry": {
      "commands": {
        "dump": {
          "dry_run_supported": false,
          "dry_run_unsupported_reason": "the dump is written with a direct file write, outside the effects handle, so a preview would report nothing while the real run rewrites the file",
          "effect": "mutating",
          "flags": [
            {
              "default": "REGISTRY.json",
              "help": "Output path for the registry dump",
              "name": "out",
              "type": "str"
            }
          ],
          "help": "Write the committed registry dump (rules, groups, tombstones) as JSON",
          "name": "dump"
        }
      },
      "help": "Rule registry artifacts (mint-once IDs, tombstones)",
      "name": "registry"
    }
  },
  "help": "strictcode: a deterministic linter for architecture, with tiered auto-fixes",
  "name": "strictcode",
  "project_id": "github.com/smm-h/strictcode",
  "schema_version": 1,
  "version": "0.1.0"
}
