{
  "schema_version": 2,
  "defaults": {
    "schema_version": 2,
    "app": {
      "env_prefix": null,
      "config": false,
      "config_format": "json",
      "config_path": null,
      "config_conflict_mode": "cli-wins",
      "proc_observe_allowlist": [],
      "global_flags": [],
      "commands": {},
      "groups": {},
      "deprecated": {},
      "tag_contracts": {},
      "checks": {},
      "config_fields": {},
      "infra": {}
    },
    "flag": {
      "short": null,
      "env": null,
      "env_separator": null,
      "prefixed": true,
      "choices": null,
      "elect_by": null,
      "unique": false,
      "conflict_mode": null,
      "negatable": null,
      "nullable": false
    },
    "arg": {
      "variadic": false,
      "choices": null
    },
    "choice": {
      "flags": []
    },
    "choice_record": {
      "help": null
    },
    "command": {
      "consequential": false,
      "dry_run_supported": true,
      "dry_run_unsupported_reason": null,
      "update_of": null,
      "write_mode": null,
      "payload_schema": null,
      "owns_stdout": false,
      "passthrough": false,
      "flags": [],
      "flag_sets": [],
      "args": [],
      "tags": [],
      "constraints": [],
      "hidden": false,
      "interactive": false,
      "config_fields": [],
      "grants": [],
      "forwarding": null
    },
    "group": {
      "commands": {},
      "groups": {},
      "deprecated": {},
      "tags": [],
      "hidden": false
    },
    "config_field": {
      "default": null,
      "bound_commands": []
    },
    "check": {
      "scope": null
    },
    "infra": {
      "roots": [],
      "handshakes": [],
      "connections": []
    }
  },
  "project_id": "github.com/smm-h/strictcode",
  "name": "strictcode",
  "version": "0.2.0",
  "help": "strictcode: a deterministic linter for architecture, with tiered auto-fixes",
  "commands": {
    "analyze": {
      "name": "analyze",
      "help": "Analyze a project or workspace directory and report findings",
      "effect": "read_only",
      "payload_schema": {
        "additionalProperties": false,
        "properties": {
          "findings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "fix": {
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "tier": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "tier",
                    "description"
                  ],
                  "type": "object"
                },
                "message": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                },
                "severity": {
                  "enum": [
                    "error",
                    "warning"
                  ]
                },
                "target": {
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "workspace_member",
                        "module",
                        "entry_point",
                        "function",
                        "closure",
                        "type",
                        "type_param",
                        "variable",
                        "endpoint",
                        "db_entity"
                      ]
                    },
                    "line": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "file",
                    "line"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "rule",
                "severity",
                "message",
                "target"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "format_version": {
            "const": 1
          },
          "strictcode_version": {
            "type": "string"
          },
          "workspace_root": {
            "type": "string"
          }
        },
        "required": [
          "format_version",
          "strictcode_version",
          "workspace_root",
          "findings"
        ],
        "type": "object"
      },
      "flags": [
        {
          "name": "config",
          "help": "Config file name, resolved relative to the analyzed directory",
          "value_schema": {
            "type": "string"
          },
          "presence": "default",
          "default": "strictcode.toml"
        }
      ],
      "args": [
        {
          "name": "dir",
          "help": "Project or workspace root to analyze",
          "value_schema": {
            "type": "string"
          },
          "presence": "default",
          "default": "."
        }
      ]
    },
    "fix": {
      "name": "fix",
      "help": "Apply tier-1 (guaranteed behavior-preserving) fixes with post-fix graph re-verification",
      "effect": "mutating",
      "dry_run_supported": false,
      "dry_run_unsupported_reason": "the file rewrites happen inside the fix package's apply-and-verify path, outside the effects handle; pass --preview to list the planned fixes without touching a file",
      "flags": [
        {
          "name": "config",
          "help": "Config file name, resolved relative to the analyzed directory; omitted means strictcode.toml",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        },
        {
          "name": "disposition",
          "help": "What to do with the planned fixes",
          "presence": "required",
          "choices": [
            {
              "name": "apply",
              "help": "rewrite the files and verify the result against the declared delta"
            },
            {
              "name": "preview",
              "help": "list the planned fixes and touch nothing"
            }
          ],
          "elect_by": "member-flags"
        }
      ],
      "args": [
        {
          "name": "dir",
          "help": "Project or workspace root; omitted means the current directory",
          "value_schema": {
            "type": "string"
          },
          "presence": "optional"
        }
      ]
    }
  },
  "groups": {
    "registry": {
      "name": "registry",
      "help": "Rule registry artifacts (mint-once IDs, tombstones)",
      "commands": {
        "dump": {
          "name": "dump",
          "help": "Write the committed registry dump (rules, groups, tombstones) as JSON",
          "effect": "mutating",
          "dry_run_supported": false,
          "dry_run_unsupported_reason": "the dump is written with a direct file write, outside the effects handle, so a preview would report nothing while the real run rewrites the file",
          "flags": [
            {
              "name": "out",
              "help": "Output path for the registry dump; omitted means REGISTRY.json",
              "value_schema": {
                "type": "string"
              },
              "presence": "optional"
            }
          ]
        }
      }
    },
    "matrix": {
      "name": "matrix",
      "help": "Language x feature support matrix",
      "commands": {
        "gen": {
          "name": "gen",
          "help": "Write the generated support matrix (rules and capabilities per language)",
          "effect": "mutating",
          "dry_run_supported": false,
          "dry_run_unsupported_reason": "the matrix is written with a direct file write, outside the effects handle, so a preview would report nothing while the real run rewrites the file",
          "flags": [
            {
              "name": "out",
              "help": "Output path for the matrix; omitted means docs/MATRIX.md",
              "value_schema": {
                "type": "string"
              },
              "presence": "optional"
            }
          ]
        }
      }
    }
  }
}
